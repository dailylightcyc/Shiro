{
  "name": "shiro",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @shiro/web build",
    "dev": "node scripts/run-next.mjs dev",
    "preview": "bash ./start-preview.sh",
    "vendors": "node scripts/run-next.mjs vendors",
    "lint": "node scripts/run-next.mjs lint",
    "prepare": "pnpm exec simple-git-hooks",
    "release": "bumpp -r",
    "release:dry": "bumpp -r --no-commit --no-tag --no-push",
    "dev:stop": "node scripts/run-next.mjs stop"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "bumpp": "^12.3.0",
    "lint-staged": "17.6.0",
    "simple-git-hooks": "2.14.0",
    "turbo": "^2.11.7"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged --concurrent false"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --ignore-path ./.gitignore --write "
    ],
    "*.{js,ts,cjs,mjs,jsx,tsx,json}": [
      "node scripts/run-next.mjs lint --fix"
    ]
  }
}
